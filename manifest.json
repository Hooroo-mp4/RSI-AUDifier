{
  "manifest_version": 3,
  "name": "Utilify",
  "version": "0.4.1",
  "description": "Handy tools for the RSI website: see prices in your own currency and recolour the site with custom themes.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.frankfurter.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://robertsspaceindustries.com/*"
      ],
      "js": [
        "themes.js",
        "theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://robertsspaceindustries.com/*"
      ],
      "js": [
        "currency.js"
      ],
      "css": [
        "currency.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Utilify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}